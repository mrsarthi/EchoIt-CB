{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EchoIt",
  "version": "0.1.0",
  "identifier": "io.github.mrsarthi.echoit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EchoIt",
        "width": 1100,
        "height": 720,
        "minWidth": 380,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzMDc3QUIzNTIzRTRFMDYKUldRR1RqNVNzM29IWTRZWEpqdDNWQ2M5TUNaWTZhQVRjUHZpUURTY3BVdzR0RHFFL3poM3dqcUkK",
      "endpoints": [
        "https://github.com/mrsarthi/EchoIt-CB/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
