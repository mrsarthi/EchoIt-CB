{
  "name": "echoit",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first, end-to-end encrypted messaging. Your messages stay on your phone.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.harness.json",
    "tauri": "tauri",
    "test:two-peer": "tsx harness/two-peer.mts",
    "test:bridge": "tsx harness/two-peer-bridge.mts",
    "test:three-peer": "tsx harness/three-peer-privacy.mts",
    "android:sign": "node scripts/apply-android-signing.mjs",
    "release:manifest": "node scripts/make-latest-json.mjs",
    "check:icon": "node scripts/check-icon.mjs"
  },
  "dependencies": {
    "@dicsussion/core": "^0.6.0",
    "@dicsussion/sdk": "^0.6.0",
    "@scure/bip39": "^1.6.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tsx": "^4.23.12",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-wasm": "^3.6.0"
  },
  "overrides": {
    "underscore": "^1.13.8"
  }
}
