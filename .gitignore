# Dependency directories
node_modules/
.pnp
.pnp.js

# Testing and debugging
test-results/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and Secrets (CRITICAL: Never commit keys or secrets)
.env
.env.local
.env.*.local
*.key
*.pem
*.secret

# Signing material (CRITICAL: a leaked keystore cannot be revoked —
# it lets anyone ship an update that impersonates the real app)
*.jks
*.keystore
keystore.properties
# Updater signing password. The private key itself is caught by *.key above.
# Losing either means no existing install can ever be updated again.
updater.properties
*.p12
*.mobileprovision

# Encrypted and plain local databases (CRITICAL: Enforce no disk leakage)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Build outputs & caches
dist/
dist-ssr/
build/
.next/
.cache/
.tauri/
.expo/
*.tsbuildinfo
*.local

# Updater manifest -- generated from a signed build by `npm run release:manifest`.
# Never hand-edited and never committed: it carries a signature that is only
# valid for one specific artifact, so a stale copy in the tree is a copy that
# disagrees with whatever was actually built.
latest.json

# Rust / Tauri build output
src-tauri/target/
src-tauri/gen/

# Staged binaries for hardware testing — 40 MB each, rebuilt on demand
dist-laptop2/

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Metadata
.DS_Store
Thumbs.db

# MACCO analysis transcripts — local only
.macco/
