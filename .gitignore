# Dependency directories
node_modules/
.pnp
.pnp.js

# Testing and debugging
test-results/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and Secrets (CRITICAL: Never commit keys or secrets)
.env
.env.local
.env.*.local
*.key
*.pem
*.secret

# Signing material (CRITICAL: a leaked keystore cannot be revoked —
# it lets anyone ship an update that impersonates the real app)
*.jks
*.keystore
keystore.properties
*.p12
*.mobileprovision

# Encrypted and plain local databases (CRITICAL: Enforce no disk leakage)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Build outputs & caches
dist/
dist-ssr/
build/
.next/
.cache/
.tauri/
.expo/
*.tsbuildinfo
*.local

# Rust / Tauri build output
src-tauri/target/
src-tauri/gen/

# Staged binaries for hardware testing — 40 MB each, rebuilt on demand
dist-laptop2/

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Metadata
.DS_Store
Thumbs.db

# MACCO analysis transcripts — local only
.macco/
